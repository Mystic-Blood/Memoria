# Memoria configuration. Copy to .env.local and fill in.

# --- Supabase (Project Settings -> API) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed to the browser
# Only needed for `npm run db:push` (Connect -> Session pooler). Not used by the app at runtime.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- AI backend -------------------------------------------------------------------
# local  always use Ollama (recommended: everything stays on your machine)
# auto   use a remote provider if its API key is set, otherwise local Ollama
# remote always use REMOTE_PROVIDER; fails loudly if its key is missing
AI_MODE=local
# REMOTE_PROVIDER=google            # google | openai (auto-detected from whichever key is set)
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional model overrides. Entries can be scoped to a backend with a prefix, so one file
# works in every mode, e.g. CHAT_MODEL=ollama:qwen3:4b,google:gemini-3.5-flash-lite
# Defaults: ollama qwen2.5:7b-instruct + nomic-embed-text | google gemini-3.5-flash-lite (chat), gemini-3.1-flash-lite (memory) + gemini-embedding-001
#           openai gpt-4.1-mini + text-embedding-3-small. All embeddings are stored at 768 dims.
# CHAT_MODEL=
# EXTRACTION_MODEL=
# RECONCILE_MODEL=
# EMBEDDING_MODEL=

# --- Only needed when hosting it (e.g. on Vercel): see docs/DEPLOY.md ----------------
# Protects the daily cron at /api/cron/staleness-sweep. Running locally, expired memories are archived
# during normal chat instead. Generate one: node -e "console.log(crypto.randomUUID())"
# CRON_SECRET=

# --- Abuse protection (only matters if other people use your instance) --------------
# Per-user chat limits, counted in the database (rolling windows). A number is the limit (0 blocks
# all chat), "off" removes it.
# Each chat message costs ~3-6 model calls (reply + background memory extraction/reconciliation).
# CHAT_LIMIT_PER_MINUTE=10
# CHAT_LIMIT_PER_DAY=200
# Safety cap on chat messages across ALL users per rolling 24 h, so many accounts together cannot
# exhaust a free API quota. Unset = unlimited; 0 pauses chat. Over the cap, /api/chat answers 503.
# CHAT_DAILY_GLOBAL_LIMIT=300
# Close registration through the app's sign-up form (existing users can still log in). For a real
# lockdown also turn off sign-ups in the Supabase dashboard: see docs/DEPLOY.md.
# SIGNUPS_DISABLED=false

# With the production build (npm run build && npm start) /api/chat refuses to run (500, reasons in the
# server log) unless the Supabase URL + both keys and a usable AI backend are configured (plus
# CRON_SECRET on Vercel). See docs/DEPLOY.md.
